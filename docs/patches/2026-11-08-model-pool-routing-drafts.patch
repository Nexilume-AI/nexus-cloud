+    await expect(page.getByText("Validated draft")).toHaveCount(0);
+    await expect(page.getByRole("button", { name: "Apply policy", exact: true })).toBeDisabled();
+  }
+  expect(errors).toEqual([]);
+});
+
+test("missing Source details leave the Pool readable but block policy submission", async ({ page }) => {
+  const errors: string[] = [];
+  page.on("pageerror", error => errors.push(error.message));
