+test("late validation from a previous Pool cannot authorize the current draft", async ({ page }) => {
+  let release!: () => void;
+  const gate = new Promise<void>(resolve => { release = resolve; });
+  await page.route("**/api/v1/models/pool-1/routing/preview/", async route => {
+    await gate;
+    await route.fulfill({ contentType: "application/json", body: JSON.stringify({ ok: true, data: {
+      valid: true, expected_revision: 2, next_revision: 3, routing_strategy: "lowest_latency",
+      candidate_count: 1, healthy_candidate_count: 1, affected_router_count: 0, risks: [], candidates: [],
+    } }) });
+  });
+  await page.goto("/model-pool?view=pool&pool=pool-1", { waitUntil: "networkidle" });
+  const pending = page.waitForRequest(request => request.url().endsWith("/models/pool-1/routing/preview/"));
+  await page.getByRole("button", { name: "Review impact", exact: true }).click();
+  await pending;
+  await page.getByRole("option", { name: /GPT-4o Backup Pool/ }).click();
+  const completed = page.waitForResponse(response => response.url().endsWith("/models/pool-1/routing/preview/"));
+  release();
+  await completed;
+  await page.getByRole("button", { name: "Apply policy", exact: true }).isEnabled().then(enabled => expect(enabled).toBe(false));
+  await expect(page.getByText("Validated draft")).toHaveCount(0);
+  await expect(page.getByRole("heading", { name: "GPT-4o Backup Pool", exact: true })).toBeVisible();
+});
