+test("Access Add person keeps typing focus through form and search updates", async ({ page }) => {
+  await mockAccessApi(page);
+  const mutations: Request[] = [];
+  page.on("request", request => {
+    if (request.url().includes("/api/v1/") && request.method() !== "GET") mutations.push(request);
+  });
+  await page.goto("/access?tab=people&target_type=project&target=project-access");
+  const trigger = page.getByRole("button", { name: /^Add person/ }).first();
+  await trigger.click();
+  const dialog = page.getByRole("dialog", { name: "Add to Project" });
+  const person = dialog.getByPlaceholder("Search name or email");
+  await person.click();
+  // Keyboard events deliberately keep the current focus; fill() would hide this regression.
+  for (const char of "focus-test@example.test") {
+    await page.keyboard.type(char);
+    await expect(person).toBeFocused();
+  }
+  await expect(person).toHaveValue("focus-test@example.test");
+  await expect(dialog.getByText(/No matching member in this Organization/)).toBeVisible();
+  await expect(person).toBeFocused();
+  const submit = dialog.getByRole("button", { name: "Add person", exact: true });
+  await expect(submit).toBeEnabled();
+  await page.keyboard.press("Tab");
+  await expect(dialog.getByRole("button", { name: "Close", exact: true })).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(submit).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(dialog.getByRole("button", { name: "Close dialog" })).toBeFocused();
+  await page.keyboard.press("Shift+Tab");
+  await expect(submit).toBeFocused();
+  await page.keyboard.press("Escape");
+  await expect(dialog).toHaveCount(0);
+  await expect(trigger).toBeFocused();
+  expect(mutations).toEqual([]);
+});
+
+test("Access Create group keeps Unicode text, caret and selection during edits", async ({ page }) => {
+  await mockAccessApi(page);
+  await page.goto("/access?tab=people");
+  const trigger = page.getByRole("button", { name: "Create", exact: true });
+  await trigger.click();
+  const dialog = page.getByRole("dialog", { name: "Create group" });
+  const name = dialog.getByLabel("Group name");
+  await name.click();
+  await page.keyboard.type("Design group", { delay: 25 });
+  await expect(name).toHaveValue("Design group");
+  await expect(name).toBeFocused();
+  await page.keyboard.press("Home");
+  await page.keyboard.press("Shift+End");
+  await page.keyboard.insertText("芯片设计组");
+  await expect(name).toHaveValue("芯片设计组");
+  await expect(name).toBeFocused();
+  await page.keyboard.press("ArrowLeft");
+  await page.keyboard.insertText("验证");
+  await expect(name).toHaveValue("芯片设计验证组");
+  await expect(name).toBeFocused();
+  await expect.poll(() => name.evaluate(input => (input as HTMLInputElement).selectionStart)).toBe(6);
+  await page.keyboard.press("Escape");
+  await expect(dialog).toHaveCount(0);
+  await expect(trigger).toBeFocused();
+});
