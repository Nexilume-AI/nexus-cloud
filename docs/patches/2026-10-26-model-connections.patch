+                raw=upstream.read(16*1024*1024+1)
+                if len(raw)>16*1024*1024 or not stream_live(row):raise ValueError()
+                raw=raw.replace(key.encode(),b'[REDACTED]')
+                return HttpResponse(raw,content_type='application/json',headers={'Cache-Control':'no-store'})
