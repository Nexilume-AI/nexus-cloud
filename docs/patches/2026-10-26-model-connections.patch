+class ConcurrentModelBudgetTests(Fixtures,TransactionTestCase):
+    def test_parallel_requests_cannot_exceed_last_slot(self):
+        if connection.vendor!='postgresql':self.skipTest('Row-lock contention requires PostgreSQL')
+        c,row,token=self.grant(limit=1)
+        from threading import Barrier
+        barrier=Barrier(4)
+        def request_one(_):
+            close_old_connections();barrier.wait()
+            try:service.admit(token,'model-a','responses');return 'admitted'
+            except exceptions.Throttled:return 'limited'
+            finally:close_old_connections()
+        with ThreadPoolExecutor(max_workers=4) as pool:results=list(pool.map(request_one,range(4)))
+        self.assertEqual(results.count('admitted'),1)
+        self.assertEqual(results.count('limited'),3)
+        c.refresh_from_db();self.assertEqual(c.requests_used,1)
