+from pathlib import Path
+import json
+import secrets
+from urllib.error import HTTPError
+from asgiref.sync import sync_to_async
+from django.db import close_old_connections
+from django.http import HttpResponse,StreamingHttpResponse
+from django.views.decorators.csrf import ensure_csrf_cookie
+from django.views.decorators.http import require_GET
+from django.utils.decorators import method_decorator
+from django.views.decorators.debug import sensitive_post_parameters,sensitive_variables
+from django.utils import timezone
+from rest_framework import exceptions
+from rest_framework.authentication import SessionAuthentication
+from rest_framework.permissions import IsAuthenticated,AllowAny
+from rest_framework.response import Response
+from apps.common.crypto import decrypt_secret
+from apps.gateway.provider_http import open_provider_url
+from .credential_views import NoStoreView
+from . import model_connections as connections
+from .models import AgentModelConnection,AgentModelPermission,AgentCredentialAuthorization
+
+
+@require_GET
+@ensure_csrf_cookie
+def page(request):
+    nonce=secrets.token_urlsafe(24)
+    html=Path(__file__).with_name('model_connections.html').read_text().replace('__NONCE__',nonce)
+    r=HttpResponse(html)
+    r['Cache-Control']='no-store, private';r['Referrer-Policy']='no-referrer';r['X-Frame-Options']='DENY'
+    r['X-Robots-Tag']='noindex, nofollow';r['X-Content-Type-Options']='nosniff'
+    r['Content-Security-Policy']=f"default-src 'none'; script-src 'nonce-{nonce}'; style-src 'nonce-{nonce}'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
+    return r
+
+
+class AccountView(NoStoreView):
+    authentication_classes=[SessionAuthentication]
+    permission_classes=[IsAuthenticated]
+    def initial(self,request,*args,**kwargs):
+        super().initial(request,*args,**kwargs)
+        if request.method=='POST' and not isinstance(request.data,dict):raise exceptions.ValidationError('A JSON object is required.')
+        if not request.user.is_active:raise exceptions.PermissionDenied('Account is inactive.')
+
+
+@method_decorator(sensitive_post_parameters('secret'),name='dispatch')
+class ConnectionsView(AccountView):
+    def get(self,request):
+        from .credential_router import available_for_user
+        return Response({'account_id':str(request.user.pk),'account':request.user.email or request.user.get_username(),
+            'connections':[connections.public(c) for c in AgentModelConnection.objects.filter(owner=request.user).select_related('owner').order_by('-created_at')[:100]],
+            'routers':available_for_user(request.user),'agents':connections.available_agents(request.user)})
+    @sensitive_variables()
+    def post(self,request):
+        if request.data.get('account_id')!=str(request.user.pk):
+            raise exceptions.PermissionDenied('Your account changed. Refresh and confirm again.')
+        return Response(connections.create(request.user,request.data),status=201)
+
+
+class PermissionsView(AccountView):
+    def post(self,request,connection_id):return Response(connections.batch(request.user,connection_id,request.data))
+
+
+class RevokeView(AccountView):
+    def post(self,request,connection_id):
+        if request.data.get('confirm') is not True:raise exceptions.ValidationError('Confirm revocation.')
+        return Response(connections.revoke(request.user,connection_id,request.data.get('permission_id')))
+
+
+def stream_live(row):
+    now=timezone.now()
+    return AgentCredentialAuthorization.objects.filter(pk=row.pk,status='authorized',expires_at__gt=now,
+        model_permission__revoked_at__isnull=True,model_permission__expires_at__gt=now,
+        model_permission__connection__revoked_at__isnull=True,model_permission__connection__expires_at__gt=now,
+        model_permission_id=row.model_permission_id,proxy_token_hash=row.proxy_token_hash,
+        model_permission__connection__owner__is_active=True).exists()
+
+
+class ModelProxyView(NoStoreView):
+    authentication_classes=[]
+    permission_classes=[AllowAny]
+    @sensitive_variables()
+    def post(self,request,operation):
+        auth=request.headers.get('Authorization','')
+        token=auth[7:] if auth.startswith('Bearer ') else request.headers.get('x-api-key','')
+        if not token.startswith('nexus-model-proxy-') or len(token)>128:raise exceptions.AuthenticationFailed('Invalid model capability.')
+        if request.query_params:raise exceptions.ValidationError('Query parameters are not supported.')
+        data=request.data
+        if not isinstance(data,dict) or len(json.dumps(data).encode())>4*1024*1024:raise exceptions.ValidationError('Model request exceeds 4 MiB.')
+        if 'stream' in data and type(data['stream']) is not bool:raise exceptions.ValidationError('stream must be a boolean.')
