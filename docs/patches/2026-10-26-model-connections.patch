+// Exercise the browser API boundary against the production Nexus envelope.
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const assert = require('node:assert/strict');
+const html = fs.readFileSync(path.join(__dirname, '../apps/agents/model_connections.html'), 'utf8');
+const script = html.slice(html.indexOf('async function api('), html.indexOf('\nfunction routers('));
+const elements = {login: {hidden: true}, content: {hidden: false}};
+let response, captured;
+const context = vm.createContext({
+  base: '/api/v1/model-connections/',
+  $: id => elements[id],
+  document: {cookie: 'csrftoken=test-csrf'},
+  fetch: async (url, options) => {captured = {url, options}; return response;},
+  Error, JSON, decodeURIComponent,
+});
+vm.runInContext(script, context);
+(async () => {
+  const catalog = {account_id: 'owner', account: 'Owner', connections: [], routers: [], agents: []};
+  response = {ok: true, status: 200, json: async () => ({success: true, data: catalog})};
+  assert.deepEqual(await context.api(), catalog);
+  assert.equal(captured.options.credentials, 'same-origin');
+  assert.equal(captured.options.cache, 'no-store');
+  response = {ok: true, status: 201, json: async () => ({data: {id: 'connection'}})};
+  assert.equal((await context.api('', {consent: true})).id, 'connection');
+  assert.equal(captured.options.headers['X-CSRFToken'], 'test-csrf');
+  response = {ok: false, status: 403, json: async () => ({error: {message: 'Sign in'}})};
+  await assert.rejects(context.api(), /Sign in/);
+  assert.equal(elements.login.hidden, false);
+  assert.equal(elements.content.hidden, true);
+  response = {ok: false, status: 400, json: async () => ({error: {message: 'Confirm selected Agents'}})};
+  await assert.rejects(context.api('id/permissions/', {}), /Confirm selected Agents/);
+  console.log('Model connections browser envelope, CSRF and authentication states: PASS');
+})().catch(error => { console.error(error); process.exitCode = 1; });
