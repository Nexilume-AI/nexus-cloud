+"""Reusable model connections. Model secrets stay in Cloud; runtimes get proxy tokens."""
+from datetime import timedelta
+import secrets
+import uuid
+from django.conf import settings
+from django.db import transaction
+from django.db.models import Q
+from django.utils import timezone
+from django.views.decorators.debug import sensitive_variables
+from rest_framework import exceptions
+from apps.common.crypto import encrypt_secret
+from apps.common.subjects import hash_token
+from .models import Agent, AgentCredentialAuthorization, AgentModelConnection, AgentModelPermission
+from .credential_config import configuration, PROVIDERS
+
+
+def integer(value, low, high, label):
+    if type(value) is not int or not low <= value <= high:
+        raise exceptions.ValidationError(f'{label} must be between {low} and {high}.')
+    return value
+
+
+def state(connection, permission=None):
+    now=timezone.now()
+    if not connection.owner.is_active or connection.revoked_at or not connection.encrypted_secret:return 'revoked'
+    if connection.expires_at <= now:return 'expired'
+    if permission:
+        if permission.revoked_at:return 'revoked'
+        if permission.expires_at <= now:return 'expired'
+    if connection.requests_used >= connection.max_requests or (permission and permission.requests_used >= permission.max_requests):return 'exhausted'
+    return 'active'
+
+
+def available_agents(user):
+    from apps.tenancy.services import visible_tenants
+    from apps.common.authorization import has_nexus_permission
+    allowed=getattr(settings,'NEXUS_AGENT_CREDENTIAL_ENABLED_AGENTS',())
+    tenants=visible_tenants(user=user).filter(status='active',deleted_at__isnull=True)
+    result=[]
+    for a in Agent.objects.filter(pk__in=allowed,status='active',deleted_at__isnull=True).filter(
+            Q(visibility='public',publication_status='published')|Q(tenant__in=tenants)).select_related('tenant'):
+        published=a.visibility=='public' and a.publication_status=='published' and bool(a.current_version)
+        if published or has_nexus_permission(user,a.tenant,'use',resource_type='agent',resource_id=str(a.pk)):
+            result.append({'id':str(a.pk),'name':a.name})
+    return result
+
+
+def permission_public(p):
+    return {'id':str(p.pk),'agent_id':str(p.agent_id),'agent_name':p.agent.name,
+            'expires_at':p.expires_at.isoformat(),'max_requests':p.max_requests,'requests_used':p.requests_used,
+            'status':state(p.connection,p)}
+
+
+def public(c):
+    return {'id':str(c.pk),'name':c.name,'provider':c.provider,'base_url':c.base_url,'model':c.model_name,
+            'router_id':str(c.router_id or ''),'expires_at':c.expires_at.isoformat(),'status':state(c),
+            'max_requests':c.max_requests,'requests_used':c.requests_used,
+            'permissions':[permission_public(p) for p in c.permissions.select_related('agent','connection__owner').order_by('created_at')]}
+
+
+@sensitive_variables()
+def issue_router_connection(c, user, router_id):
+    from .credential_router import available_for_user
+    found=next((r for r in available_for_user(user) if r['router_id']==str(router_id) and c.model_name in r['models']),None)
+    if not found:raise exceptions.PermissionDenied('Select one of your available Routers and models.')
+    from apps.routers.models import Router
+    from apps.api_keys.models import APIKey,APIKeyPolicy,APIKeyUsageSummary,RouterCallerCredential
+    from apps.api_keys.services import hash_key
+    router=Router.objects.get(pk=router_id)
+    token='sk-nexus-modelconn-'+secrets.token_urlsafe(32)
+    key=APIKey.objects.create(tenant=router.tenant,project=router.project,name='Model connection '+str(c.pk),created_by=user,key_prefix=token[:32],key_hash=hash_key(token))
+    RouterCallerCredential.objects.create(api_key=key,router=router,owner=user)
+    APIKeyPolicy.objects.create(api_key=key,allowed_routers=[str(router.pk)],allowed_models=[c.model_name],
+        allowed_surfaces=['models'],allowed_operations=['responses','chat.completions'],no_store_prompt=True,no_store_response=True)
+    APIKeyUsageSummary.objects.create(api_key=key,tenant=router.tenant,project=router.project)
+    c.router_id,c.issued_key_id,c.encrypted_secret=router.pk,key.pk,encrypt_secret(token)
+
+
+@transaction.atomic
+@sensitive_variables()
+def create(user,data):
+    if data.get('consent') is not True:raise exceptions.ValidationError('Explicit confirmation is required.')
+    from django.contrib.auth import get_user_model
+    get_user_model().objects.select_for_update().get(pk=user.pk)
+    if AgentModelConnection.objects.filter(owner=user,revoked_at__isnull=True).count()>=32:raise exceptions.ValidationError('Revoke an old connection before creating another.')
+    provider,url,model=configuration(data.get('provider'),data.get('base_url'),data.get('model'),require_model=True,resolve=True)
+    name=data.get('name','')
+    if not isinstance(name,str) or not 1<=len(name.strip())<=100:raise exceptions.ValidationError('Enter a connection name (1–100 characters).')
+    ttl=integer(data.get('ttl_seconds',86400),300,2592000,'Connection lifetime')
+    limit=integer(data.get('max_requests',500),1,1000000,'Request allowance')
+    c=AgentModelConnection(owner=user,name=name.strip(),provider=provider,base_url=url,model_name=model,
+        expires_at=timezone.now()+timedelta(seconds=ttl),max_requests=limit)
+    if provider=='nexus':
+        if data.get('secret'):raise exceptions.ValidationError('Nexus connections use your Router, not an API key.')
+        issue_router_connection(c,user,data.get('router_id'))
+    else:
+        key=data.get('secret')
+        if not isinstance(key,str) or not 8<=len(key)<=8192 or any(ch.isspace() for ch in key):raise exceptions.ValidationError('Enter a valid API key.')
+        c.encrypted_secret=encrypt_secret(key)
+    c.save()
+    return public(c)
+
+
+@transaction.atomic
+def batch(user,connection_id,data):
+    c=AgentModelConnection.objects.select_for_update().filter(pk=connection_id,owner=user).first()
+    if not c:raise exceptions.NotFound()
+    if data.get('consent') is not True:raise exceptions.ValidationError('Confirm the selected Agents and limits.')
+    if state(c)!='active':raise exceptions.ValidationError('Connection is expired, revoked or exhausted.')
+    ids=data.get('agent_ids')
+    if not isinstance(ids,list) or not 1<=len(ids)<=100 or len(set(map(str,ids)))!=len(ids):raise exceptions.ValidationError('Select 1–100 distinct Agents.')
+    valid={a['id'] for a in available_agents(user)}
+    if any(str(a) not in valid for a in ids):raise exceptions.PermissionDenied('One or more Agents are unavailable; nothing was authorized.')
+    ttl=integer(data.get('ttl_seconds',86400),300,2592000,'Permission lifetime')
+    maximum=integer(data.get('max_requests',100),1,1000000,'Per-Agent allowance')
+    expiry=min(c.expires_at,timezone.now()+timedelta(seconds=ttl))
+    for aid in ids:
+        p,created=AgentModelPermission.objects.get_or_create(connection=c,agent_id=aid,defaults={'expires_at':expiry,'max_requests':maximum})
+        if not created:
+            if p.requests_used>=maximum:raise exceptions.ValidationError('New allowance must exceed requests already used; counters never reset.')
+            # Old delegated tokens must not revive when permission is re-approved.
+            p.authorizations.update(status='revoked',encrypted_secret='',proxy_token_hash='')
+            p.expires_at,p.max_requests,p.revoked_at=expiry,maximum,None
+            p.save(update_fields=['expires_at','max_requests','revoked_at'])
+    return public(c)
+
+
+@transaction.atomic
+def revoke(user,connection_id,permission_id=None):
+    c=AgentModelConnection.objects.select_for_update().filter(pk=connection_id,owner=user).first()
+    if not c:raise exceptions.NotFound()
+    if permission_id is not None:
+        try:permission_id=uuid.UUID(str(permission_id))
+        except (ValueError,TypeError,AttributeError):raise exceptions.ValidationError('Choose a valid Agent permission.') from None
+        p=c.permissions.filter(pk=permission_id).first()
+        if not p:raise exceptions.NotFound()
+        p.revoked_at=timezone.now();p.save(update_fields=['revoked_at'])
+        p.authorizations.update(status='revoked',encrypted_secret='',proxy_token_hash='')
+    else:
+        c.revoked_at,c.encrypted_secret=timezone.now(),'';c.save(update_fields=['revoked_at','encrypted_secret'])
+        AgentCredentialAuthorization.objects.filter(model_permission__connection=c).update(status='revoked',encrypted_secret='',proxy_token_hash='')
+        if c.issued_key_id:
+            from apps.api_keys.models import APIKey
+            APIKey.objects.filter(pk=c.issued_key_id).update(status='revoked')
+    return public(c)
+
+
+def grant_state(row):
+    p=row.model_permission
+    if (not p or p.agent_id!=row.run.agent_id or str(p.connection.owner_id)!=str(row.owner_id) or
+            p.connection.provider!=row.provider or p.connection.base_url!=row.base_url or p.connection.model_name!=row.model_name):return 'revoked'
+    value=state(p.connection,p)
+    return 'authorized' if value=='active' else value
+
+
+def proxy_base():
+    value=str(getattr(settings,'NEXUS_PUBLIC_BASE_URL','')).rstrip('/')
+    configuration('custom_openai',value,'validation')
+    return value+'/api/v1/agent-model-proxy'
+
+
+@transaction.atomic
+def reuse(run,owner,provider,url,model,explicit=False):
+    """Only an explicit stored Agent permission can mint another runtime grant."""
+    candidates=AgentModelPermission.objects.filter(connection__owner_id=owner,agent_id=run.agent_id,
+        revoked_at__isnull=True,expires_at__gt=timezone.now()).select_related('connection__owner').order_by('-created_at')
+    for p in candidates:
+        c=p.connection
+        if model and c.model_name!=model:continue
+        if explicit and (c.provider!=provider or c.base_url!=url):continue
+        if PROVIDERS[c.provider]['protocol']!=PROVIDERS[provider]['protocol'] or state(c,p)!='active':continue
+        # Serialize with batch updates/revocation; all admissions use parent-first locks.
+        c=AgentModelConnection.objects.select_for_update().get(pk=c.pk)
+        p=AgentModelPermission.objects.select_for_update().get(pk=p.pk)
+        if state(c,p)!='active':continue
+        token='nexus-model-proxy-'+secrets.token_urlsafe(32)
+        defaults={'owner_id':owner,'status':'authorized','base_url':c.base_url,'model_name':c.model_name,
+            'expires_at':min(c.expires_at,p.expires_at,timezone.now()+timedelta(hours=24)),
+            'model_permission':p,'proxy_token_hash':hash_token(token),'encrypted_secret':encrypt_secret(token),
+            'router_id':c.router_id,'source_grant':None,'issued_key_id':None,
+            'approval_mode':'caller','approved_by':None,'preauthorized':False}
+        row,created=AgentCredentialAuthorization.objects.get_or_create(run=run,provider=c.provider,interactive_view__isnull=True,defaults=defaults)
+        if not created:
+            from .credential_services import grant_state as effective_state
+            if row.model_permission_id == p.pk and str(row.owner_id) == str(c.owner_id) and effective_state(row)=='authorized':return row
+            if row.issued_key_id:
+                from apps.api_keys.models import APIKey
+                APIKey.objects.filter(pk=row.issued_key_id).update(status='revoked')
+            for k,v in defaults.items():setattr(row,k,v)
+            row.save()
+        return row
+    return None
+
+
+@transaction.atomic
+@sensitive_variables()
+def admit(token,model,operation):
+    row=AgentCredentialAuthorization.objects.filter(proxy_token_hash=hash_token(token)).select_related('run','model_permission__connection').first()
+    if not row or not row.model_permission_id:raise exceptions.AuthenticationFailed('Invalid model capability.')
+    c=AgentModelConnection.objects.select_for_update().select_related('owner').get(pk=row.model_permission.connection_id)
+    p=AgentModelPermission.objects.select_for_update().get(pk=row.model_permission_id)
+    row=AgentCredentialAuthorization.objects.select_for_update().get(pk=row.pk)
+    from .credential_services import owner_id,enabled
+    enabled(row.run)
+    if row.run.agent.status!='active' or row.run.agent.deleted_at:
+        raise exceptions.PermissionDenied('Agent is no longer available.')
+    if (row.status!='authorized' or row.expires_at<=timezone.now() or not secrets.compare_digest(row.proxy_token_hash,hash_token(token)) or
+            row.model_permission_id!=p.pk or row.owner_id!=c.owner_id or
+            str(owner_id(row.run))!=str(c.owner_id) or p.agent_id!=row.run.agent_id):raise exceptions.AuthenticationFailed('Model authorization is no longer active.')
+    value=state(c,p)
+    if value=='exhausted':raise exceptions.Throttled(detail='Model request allowance exhausted.')
+    if value!='active':raise exceptions.PermissionDenied('Model connection expired or revoked.')
+    if model!=c.model_name:raise exceptions.PermissionDenied('Model is outside the approved scope.')
+    protocol=PROVIDERS[c.provider]['protocol']
+    if operation not in (('chat/completions','responses') if protocol=='openai' else ('v1/messages',)):
+        raise exceptions.PermissionDenied('Operation is outside the approved scope.')
+    if c.provider=='nexus':
+        from .credential_router import available_for_user
+        from apps.api_keys.models import APIKey
+        if not APIKey.objects.filter(pk=c.issued_key_id,status='active',deleted_at__isnull=True).exists() or not any(
+            r['router_id']==str(c.router_id) and c.model_name in r['models'] for r in available_for_user(c.owner)):
+            raise exceptions.PermissionDenied('Router access is no longer available.')
+    c.requests_used+=1;p.requests_used+=1
+    c.save(update_fields=['requests_used']);p.save(update_fields=['requests_used'])
+    # Count admitted dispatches, including transport/upstream failures. Never refund a
+    # possibly executed request. Streams count once, not once per emitted chunk.
+    return c,p,row
