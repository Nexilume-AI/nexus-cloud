+            while True:
+                chunk=self.upstream.read1(65536)
+                if not stream_live(self.row):
+                    self.close();raise StopIteration
+                data=(self.pending+chunk).replace(self.key,b'[REDACTED]')
+                if not chunk:
+                    self.close()
+                    if data:return data
+                    raise StopIteration
+                # Hold only an actual partial key prefix, preserving SSE latency.
+                hold=0
+                for size in range(min(len(self.key)-1,len(data)),0,-1):
+                    if data.endswith(self.key[:size]):hold=size;break
+                self.pending=data[-hold:] if hold else b''
+                ready=data[:-hold] if hold else data
+                if ready:return ready
+        except BaseException:
+            self.close();raise
+
+    def read_step(self):
+        try:return next(self)
+        except StopIteration:return None
+        finally:close_old_connections()
+
+    async def async_chunks(self):
+        try:
+            while True:
+                chunk=await sync_to_async(self.read_step,thread_sensitive=False)()
+                if chunk is None:return
+                yield chunk
+        finally:await sync_to_async(self.close,thread_sensitive=False)()
+
+    def close(self):
+        if not self.closed:
+            self.closed=True;self.pending=b''
+            self.transport.__exit__(None,None,None)
