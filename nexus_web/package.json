{
  "name": "nexus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:community": "tsc -p tsconfig.community.json && vite build --config vite.community.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.community.json",
    "test:unit": "vitest run src",
    "generate:api": "openapi-typescript ../nexus_server/openapi.yaml -o src/lib/openapi.d.ts",
    "test:i18n": "npm run build:community && playwright test --config tooling/localization/playwright.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-table": "^8.21.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.15"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  }
}
